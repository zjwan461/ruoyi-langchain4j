FROM python:3.11-slim AS builder

# 替换apt源
RUN sed -i "s@deb.debian.org@mirrors.aliyun.com@g" /etc/apt/sources.list.d/debian.sources \
    && sed -i "s@security.debian.org@mirrors.aliyun.com@g" /etc/apt/sources.list.d/debian.sources

RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-core \
    fonts-wqy-zenhei \
    libglib2.0-0 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8
ENV PYTHONIOENCODING=utf-8
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY doc-parser/requirements.txt .
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt

# 处理opencv libGL报错核心命令
RUN pip install --no-cache-dir rapidocr-onnxruntime
RUN pip uninstall -y opencv-python && pip install --no-cache-dir opencv-python-headless

COPY doc-parser/ .

# 构建阶段传入代理，下载模型
ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV http_proxy=$HTTP_PROXY
ENV https_proxy=$HTTPS_PROXY
RUN python utils/pdf_model_download.py

# ========== 最终运行镜像，完全继承文件，但不带代理环境变量 ==========
FROM python:3.11-slim
# 复制系统依赖、python环境、代码、下载好的模型
COPY --from=builder / /

ENV LANG=C.UTF-8
ENV PYTHONIOENCODING=utf-8
ENV PYTHONUNBUFFERED=1

WORKDIR /app

EXPOSE 8143
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8143"]