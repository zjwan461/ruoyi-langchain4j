<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.AgentSkillMapper">
    
    <resultMap type="AgentSkill" id="AgentSkillResult">
        <result property="id"    column="id"    />
        <result property="skillName"    column="skill_name"    />
        <result property="skillDescription"    column="skill_description"    />
        <result property="skillContent"    column="skill_content"    />
        <result property="skillType"    column="skill_type"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="selectAgentSkillVo">
        select id, skill_name, skill_description, skill_content, skill_type, create_time, update_time, create_by, update_by from agent_skill
    </sql>

    <select id="selectAgentSkillList" parameterType="AgentSkill" resultMap="AgentSkillResult">
        <include refid="selectAgentSkillVo"/>
        <where>  
            <if test="skillName != null  and skillName != ''"> and skill_name like concat('%', #{skillName}, '%')</if>
            <if test="skillDescription != null  and skillDescription != ''"> and skill_description = #{skillDescription}</if>
            <if test="skillContent != null  and skillContent != ''"> and skill_content = #{skillContent}</if>
            <if test="skillType != null  and skillType != ''"> and skill_type = #{skillType}</if>
        </where>
    </select>
    
    <select id="selectAgentSkillById" parameterType="Long" resultMap="AgentSkillResult">
        <include refid="selectAgentSkillVo"/>
        where id = #{id}
    </select>

    <insert id="insertAgentSkill" parameterType="AgentSkill" useGeneratedKeys="true" keyProperty="id">
        insert into agent_skill
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="skillName != null and skillName != ''">skill_name,</if>
            <if test="skillDescription != null and skillDescription != ''">skill_description,</if>
            <if test="skillContent != null and skillContent != ''">skill_content,</if>
            <if test="skillType != null and skillType != ''">skill_type,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="skillName != null and skillName != ''">#{skillName},</if>
            <if test="skillDescription != null and skillDescription != ''">#{skillDescription},</if>
            <if test="skillContent != null and skillContent != ''">#{skillContent},</if>
            <if test="skillType != null and skillType != ''">#{skillType},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
         </trim>
    </insert>

    <update id="updateAgentSkill" parameterType="AgentSkill">
        update agent_skill
        <trim prefix="SET" suffixOverrides=",">
            <if test="skillName != null and skillName != ''">skill_name = #{skillName},</if>
            <if test="skillDescription != null and skillDescription != ''">skill_description = #{skillDescription},</if>
            <if test="skillContent != null and skillContent != ''">skill_content = #{skillContent},</if>
            <if test="skillType != null and skillType != ''">skill_type = #{skillType},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAgentSkillById" parameterType="Long">
        delete from agent_skill where id = #{id}
    </delete>

    <delete id="deleteAgentSkillByIds" parameterType="String">
        delete from agent_skill where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 根据技能名称数组批量查询技能信息 -->
    <select id="selectAgentSkillByNames" parameterType="java.lang.String" resultMap="AgentSkillResult">
        <include refid="selectAgentSkillVo"/>
        where skill_name in
        <foreach collection="list" item="name" open="(" separator="," close=")">
            #{name}
        </foreach>
    </select>

    <delete id="deleteAgentSkillByNames" parameterType="String">
        delete from agent_skill where skill_name in
        <foreach item="name" collection="list" open="(" separator="," close=")">
            #{name}
        </foreach>
    </delete>

    <!-- 批量新增技能信息 -->
    <insert id="batchInsertAgentSkill" parameterType="java.util.List">
        insert into agent_skill (skill_name, skill_description, skill_content, skill_type, create_time, update_time, create_by, update_by)
        values
        <foreach collection="list" item="item" separator=",">
            (
            #{item.skillName},
            #{item.skillDescription},
            #{item.skillContent},
            #{item.skillType},
            #{item.createTime},
            #{item.updateTime},
            #{item.createBy},
            #{item.updateBy}
            )
        </foreach>
    </insert>
</mapper>