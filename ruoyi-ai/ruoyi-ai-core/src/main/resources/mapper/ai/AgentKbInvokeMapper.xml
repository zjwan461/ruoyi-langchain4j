<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.AgentKbInvokeMapper">

    <resultMap type="AgentKbInvoke" id="AgentKbInvokeResult">
        <result property="id"    column="id"    />
        <result property="agentId"    column="agent_id"    />
        <result property="clientId"    column="client_id"    />
        <result property="sessionId"    column="session_id"    />
        <result property="messageId"    column="message_id"    />
        <result property="fileName"    column="file_name"    />
        <result property="text"    column="text"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectAgentKbInvokeVo">
        select id, agent_id, client_id, session_id, message_id, file_name, text, create_time from agent_kb_invoke
    </sql>

    <select id="selectAgentKbInvokeList" parameterType="AgentKbInvoke" resultMap="AgentKbInvokeResult">
        <include refid="selectAgentKbInvokeVo"/>
        <where>
            <if test="agentId != null "> and agent_id = #{agentId}</if>
            <if test="clientId != null  and clientId != ''"> and client_id = #{clientId}</if>
            <if test="sessionId != null  and sessionId != ''"> and session_id = #{sessionId}</if>
            <if test="messageId != null  and messageId != ''"> and message_id = #{messageId}</if>
            <if test="fileName != null  and fileName != ''"> and file_name like concat('%', #{fileName}, '%')</if>
        </where>
    </select>

    <select id="selectAgentKbInvokeById" parameterType="Long" resultMap="AgentKbInvokeResult">
        <include refid="selectAgentKbInvokeVo"/>
        where id = #{id}
    </select>

    <insert id="insertAgentKbInvoke" parameterType="AgentKbInvoke">
        insert into agent_kb_invoke
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="agentId != null">agent_id,</if>
            <if test="clientId != null and clientId != ''">client_id,</if>
            <if test="sessionId != null and sessionId != ''">session_id,</if>
            <if test="messageId != null and messageId != ''">message_id,</if>
            <if test="fileName != null and fileName != ''">file_name,</if>
            <if test="text != null and text != ''">text,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="agentId != null">#{agentId},</if>
            <if test="clientId != null and clientId != ''">#{clientId},</if>
            <if test="sessionId != null and sessionId != ''">#{sessionId},</if>
            <if test="messageId != null and messageId != ''">#{messageId},</if>
            <if test="fileName != null and fileName != ''">#{fileName},</if>
            <if test="text != null and text != ''">#{text},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateAgentKbInvoke" parameterType="AgentKbInvoke">
        update agent_kb_invoke
        <trim prefix="SET" suffixOverrides=",">
            <if test="agentId != null">agent_id = #{agentId},</if>
            <if test="clientId != null and clientId != ''">client_id = #{clientId},</if>
            <if test="sessionId != null and sessionId != ''">session_id = #{sessionId},</if>
            <if test="messageId != null and messageId != ''">message_id = #{messageId},</if>
            <if test="fileName != null and fileName != ''">file_name = #{fileName},</if>
            <if test="text != null and text != ''">text = #{text},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAgentKbInvokeById" parameterType="Long">
        delete from agent_kb_invoke where id = #{id}
    </delete>

    <delete id="deleteAgentKbInvokeByIds" parameterType="String">
        delete from agent_kb_invoke where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
