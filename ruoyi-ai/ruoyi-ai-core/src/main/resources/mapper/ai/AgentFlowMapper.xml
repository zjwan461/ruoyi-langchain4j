<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.AgentFlowMapper">
    
    <resultMap type="AgentFlow" id="AgentFlowResult">
        <result property="id"    column="id"    />
        <result property="agentFlowName"    column="agent_flow_name"    />
        <result property="flowJson"    column="flow_json"    />
        <result property="visitUrl"    column="visit_url"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="selectAgentFlowVo">
        select id, agent_flow_name, flow_json,visit_url, status, create_time, update_time, create_by, update_by from agent_flow
    </sql>

    <select id="selectAgentFlowList" parameterType="AgentFlow" resultMap="AgentFlowResult">
        <include refid="selectAgentFlowVo"/>
        <where>  
            <if test="agentFlowName != null  and agentFlowName != ''"> and agent_flow_name like concat('%', #{agentFlowName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectAgentFlowById" parameterType="Long" resultMap="AgentFlowResult">
        <include refid="selectAgentFlowVo"/>
        where id = #{id}
    </select>

    <insert id="insertAgentFlow" parameterType="AgentFlow" useGeneratedKeys="true" keyProperty="id">
        insert into agent_flow
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="agentFlowName != null and agentFlowName != ''">agent_flow_name,</if>
            <if test="flowJson != null">flow_json,</if>
            <if test="visitUrl != null">visit_url,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="agentFlowName != null and agentFlowName != ''">#{agentFlowName},</if>
            <if test="flowJson != null">#{flowJson},</if>
            <if test="visitUrl != null">#{visitUrl},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
         </trim>
    </insert>

    <update id="updateAgentFlow" parameterType="AgentFlow">
        update agent_flow
        <trim prefix="SET" suffixOverrides=",">
            <if test="agentFlowName != null and agentFlowName != ''">agent_flow_name = #{agentFlowName},</if>
            <if test="flowJson != null">flow_json = #{flowJson},</if>
            <if test="visitUrl != null">visit_url = #{visitUrl},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAgentFlowById" parameterType="Long">
        delete from agent_flow where id = #{id}
    </delete>

    <delete id="deleteAgentFlowByIds" parameterType="String">
        delete from agent_flow where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>