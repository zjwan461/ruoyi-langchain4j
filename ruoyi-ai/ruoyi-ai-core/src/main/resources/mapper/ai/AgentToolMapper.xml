<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.AgentToolMapper">
    
    <resultMap type="AgentTool" id="AgentToolResult">
        <result property="id"    column="id"    />
        <result property="toolName"    column="tool_name"    />
        <result property="toolType"    column="tool_type"    />
        <result property="code"    column="code"    />
        <result property="clazz"    column="clazz"    />
        <result property="parameters"    column="parameters"    />
        <result property="description"    column="description"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="selectAgentToolVo">
        select id, tool_name, tool_type, code, clazz, parameters, description, create_time, update_time, create_by, update_by from agent_tool
    </sql>

    <select id="selectAgentToolList" parameterType="AgentTool" resultMap="AgentToolResult">
        <include refid="selectAgentToolVo"/>
        <where>  
            <if test="toolName != null  and toolName != ''"> and tool_name like concat('%', #{toolName}, '%')</if>
            <if test="toolType != null  and toolType != ''"> and tool_type = #{toolType}</if>
        </where>
    </select>
    
    <select id="selectAgentToolById" parameterType="Long" resultMap="AgentToolResult">
        <include refid="selectAgentToolVo"/>
        where id = #{id}
    </select>

    <insert id="insertAgentTool" parameterType="AgentTool">
        insert into agent_tool
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="toolName != null and toolName != ''">tool_name,</if>
            <if test="toolType != null and toolType != ''">tool_type,</if>
            <if test="code != null">code,</if>
            <if test="clazz != null">clazz,</if>
            <if test="parameters != null">parameters,</if>
            <if test="description != null">description,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="toolName != null and toolName != ''">#{toolName},</if>
            <if test="toolType != null and toolType != ''">#{toolType},</if>
            <if test="code != null">#{code},</if>
            <if test="clazz != null">#{clazz},</if>
            <if test="parameters != null">#{parameters},</if>
            <if test="description != null">#{description},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
         </trim>
    </insert>

    <update id="updateAgentTool" parameterType="AgentTool">
        update agent_tool
        <trim prefix="SET" suffixOverrides=",">
            <if test="toolName != null and toolName != ''">tool_name = #{toolName},</if>
            <if test="toolType != null and toolType != ''">tool_type = #{toolType},</if>
            <if test="code != null">code = #{code},</if>
            <if test="clazz != null">clazz = #{clazz},</if>
            <if test="parameters != null">parameters = #{parameters},</if>
            <if test="description != null">description = #{description},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAgentToolById" parameterType="Long">
        delete from agent_tool where id = #{id}
    </delete>

    <delete id="deleteAgentToolByIds" parameterType="String">
        delete from agent_tool where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectAgentToolByAgentId" parameterType="java.lang.Long" resultMap="AgentToolResult">
        select a.* from agent_tool a join agent_tool_mapping b on a.id = b.tool_id join ai_agent c on b.agent_id = c.id
        where c.agent_id = #{agentId}
    </select>
</mapper>